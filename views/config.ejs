<div class="col col-md-2">
    <div class="row">
        <a href="/config/add" class="btn btn-success">tambah data</a>
    </div>
</div>
<div class="col mt-5">
    <div class="row">
        <h3>Tabel Kriteria</h3>
        <table class="table mt-2">
            <thead>
                <tr>
                <th scope="col">No</th>
                <th scope="col">Nama Kriteria</th>
                <th scope="col">Kriteria</th>
                <th scope="col">NN</th>
                <th scope="col">NA</th>
                <th scope="col">NS</th>
                <th scope="col">ND</th>
                <th scope="col">NK</th>
                <th scope="col">NR</th>
                </tr>
            </thead>
            <tbody>
                <% nilai.forEach((e,i) => { %>
                <tr>
                    <th scope="row"><%= i+1 %></th>
                    <td><%= e.Nama_Kriteria %></td>
                    <td><%= e.key %></td>
                    <td><%= e.nn %></td>
                    <td><%= e.na %></td>
                    <td><%= e.ns %></td>
                    <td><%= e.nd %></td>
                    <td><%= e.nk %></td>
                    <td><%= e.nr %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<div class="col mt-3">
    <div class="row">
        <h3>Tabel Eigen</h3>
        <table class="table mt-2">
            <thead>
                <tr>
                <th scope="col">No</th>
                <th scope="col">Kriteria</th>
                <th scope="col">NN</th>
                <th scope="col">NA</th>
                <th scope="col">NS</th>
                <th scope="col">ND</th>
                <th scope="col">NK</th>
                <th scope="col">NR</th>
                <th scope="col">Jumlha</th>
                <th scope="col">Rata-Rata</th>
                </tr>
            </thead>
            <tbody>
                <% eigen.forEach(e => { %>
                <tr>
                    <th scope="row">1</th>
                    <td><%= e.key %></td>
                    <td><%= e.nn %></td>
                    <td><%= e.na %></td>
                    <td><%= e.ns %></td>
                    <td><%= e.nd %></td>
                    <td><%= e.nk %></td>
                    <td><%= e.nr %></td>
                    <td><%= e.jumlah %></td>
                    <td><%= e.rata %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

